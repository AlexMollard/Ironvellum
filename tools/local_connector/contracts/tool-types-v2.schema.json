{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "datasetId": {
          "$ref": "context-v2.schema.json#/$defs/uuid"
        },
        "snapshotId": {
          "$ref": "context-v2.schema.json#/$defs/uuid"
        },
        "exportedAtMs": {
          "$ref": "context-v2.schema.json#/$defs/time"
        },
        "ageMs": {
          "$ref": "context-v2.schema.json#/$defs/time"
        },
        "coverage": {
          "$ref": "context-v2.schema.json#/$defs/coverage"
        }
      },
      "required": [
        "schemaVersion",
        "datasetId",
        "snapshotId",
        "exportedAtMs",
        "ageMs",
        "coverage"
      ]
    },
    "movementResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "context-v2.schema.json#/$defs/key"
        },
        "name": {
          "type": "string"
        },
        "metric": {
          "anyOf": [
            {
              "$ref": "context-v2.schema.json#/$defs/metric"
            },
            {
              "type": "null"
            }
          ]
        },
        "custom": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "enum": [
            "CATALOGUE",
            "LOCAL",
            "HISTORICAL",
            "MANIFEST"
          ]
        },
        "loadSemantics": {
          "enum": [
            "EXTERNAL",
            "ASSISTANCE",
            "UNKNOWN"
          ]
        },
        "draftable": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "name",
        "metric",
        "custom",
        "source",
        "loadSemantics",
        "draftable"
      ]
    },
    "proposedFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot": {
          "$ref": "tool-types-v2.schema.json#/$defs/snapshot"
        },
        "status": {
          "const": "proposed"
        },
        "filename": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json(?![\\s\\S])"
        },
        "proposal": {
          "$ref": "files-v1.schema.json#/$defs/proposal"
        }
      },
      "required": [
        "snapshot",
        "status",
        "filename",
        "proposal"
      ]
    }
  }
}
