<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- Saves a finished workout as an exercise session; only used when the
         lifter turns "Save finished workouts" on in Settings > Health Connect. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <!-- Lets step reads reach data recorded before the app was installed;
         requested from Settings alongside the data reads. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Lets the Health Connect read run from a background worker, not only
         while the app is open; requested from Settings. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <!-- Four things post notifications (ids and channels in data/Notifications.kt):
         the live trial's ongoing notification and its rest-over buzz (the grant
         is asked once, when the first trial starts), the optional evening
         Summons (asked when it is enabled in Settings), and ally activity
         (asked once, on first opening Allies, or from Account). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Held only while a rest between sets counts down, with a timeout, so the
         rest-over buzz is not delayed by deep sleep with the phone locked. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The buzz that cues the last seconds of a timed set (and the rest alert's
         own vibration setting). A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The mid-workout notification runs as a special-use foreground service:
         it mirrors the live session the lifter has open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 16: lets the workout notification ask to be promoted to a Live Update (status-bar chip, lock-screen
         card). Not a runtime permission; the lifter's own switch is in Android's settings (Settings > Lock screen and shortcuts). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
      Package visibility: without this, getSdkStatus() cannot see the Health
      Connect provider and always reports SDK_UNAVAILABLE, so the Connect &
      Sync action reads "unavailable" on a device that actually supports it.
      The APK-based provider is used pre-Android-14; from 14 it is a system
      module, but the rationale intent query is still required.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <!-- Whether a camera app can take a progress photo; with none, the photo steps offer only the picker. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".IronvellumApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ironvellum">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <!-- Long-press the icon: Start today, Resume (res/xml/shortcuts.xml). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Quick Settings tile: start today's workout, or return to the one running. Added by the lifter
             (Settings > Lock screen and shortcuts asks Android to add it). -->
        <service
            android:name=".LiveWorkoutTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_workout"
            android:label="@string/live_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The trial notification's Set done, Skip rest and +15 s buttons. Broadcasts
             run from the lock screen; not exported, only our own PendingIntents. -->
        <receiver
            android:name=".TrialActionReceiver"
            android:exported="false" />

        <!-- Live-session companion notification. specialUse because "glanceable
             workout progress" is not one of the platform's fixed FGS types;
             the subtype documents that for the Play review, should one happen. -->
        <service
            android:name=".WorkoutSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Displays live progress of the workout session the user has open." />
        </service>

        <!-- Re-books the evening Summons when the timezone or the clock moves:
             WorkManager's delay is elapsed time and would keep the old 19:30.
             Both are protected system broadcasts, so it need not be exported. -->
        <receiver
            android:name=".data.TimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets: "Today" (the day card) and "Streak & week". Redrawn by the
             app (widget/TodayWidget.kt); the platform's APPWIDGET_UPDATE is only the first
             draw when one is placed. -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.WeekWidgetProvider"
            android:exported="true"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <!--
          Android 14+ requires a privacy-rationale entry point for health
          permissions. Without it every read throws IllegalStateException
          ("Incorrect health permission state") even when the permissions are
          granted, which surfaced as Health Connect looking broken.
        -->
        <!--
          The export is the data-rescue path, and at five years of training it
          is ~0.9 MB of JSON. Passing that as an intent extra throws
          TransactionTooLargeException (binder caps a transaction near 1 MB), so
          the share sheet gets a content:// URI for a staged file instead.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
