<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude the Room database (and WAL/SHM sidecars) from cloud backup and device-to-device transfer: body measurements never leave this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="ironvellum.db" />
        <exclude domain="database" path="ironvellum.db-wal" />
        <exclude domain="database" path="ironvellum.db-shm" />
    <!--
      The snapshots are byte copies of the database, so excluding ironvellum.db
      while backing these up would leak exactly the data the exclusion exists
      to protect. The crash journal carries stack traces from this device.
    -->
    <exclude domain="file" path="db-snapshots" />
    <exclude domain="file" path="crash" />
    <!-- Progress photos stay on this phone and in the lifter's own backup folder; Google's backup and device transfer never carry them. -->
    <exclude domain="file" path="photos" />
    <!--
      App state that only makes sense beside the database above. Restored
      without it, "onboarding" (dismissed) and "program_answers" skip first run
      into an empty app, and "reminders" shows a toggle that is on while no
      work is scheduled and notification permission is gone.
    -->
    <exclude domain="sharedpref" path="onboarding.xml" />
    <exclude domain="sharedpref" path="program_answers.xml" />
    <exclude domain="sharedpref" path="reminders.xml" />
    <!-- The folder permission belongs to this install; a restored folder name would show a backup that is no longer on. -->
    <exclude domain="sharedpref" path="auto_backup.xml" />
    <!-- The warm-up answer names a trial id, which means nothing in a fresh database. -->
    <exclude domain="sharedpref" path="warmup.xml" />
    <!-- The notify mark and first-ask flag belong to this install's account and permission state. -->
    <exclude domain="sharedpref" path="inbox_notifier.xml" />
    <!-- Paid-circle-week flags are meaningless, and double-paying-adjacent, without the database. -->
    <exclude domain="sharedpref" path="warband_payout.xml" />
    <exclude domain="sharedpref" path="circle_payout.xml" />
    <exclude domain="sharedpref" path="rank_state.xml" />
    <exclude domain="sharedpref" path="health_write.xml" />
    <exclude domain="sharedpref" path="health_resume.xml" />
    <exclude domain="sharedpref" path="weekly_recap.xml" />
    <exclude domain="sharedpref" path="suggestion_dismissals.xml" />
    <!-- The cloud sign-in: supabase-kt keeps its access and refresh token here (its default
         SettingsSessionManager). Restored elsewhere, two installs would share one rotating token. -->
    <exclude domain="sharedpref" path="com.ironvellum.app_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="ironvellum.db" />
        <exclude domain="database" path="ironvellum.db-wal" />
        <exclude domain="database" path="ironvellum.db-shm" />
    <!--
      The snapshots are byte copies of the database, so excluding ironvellum.db
      while backing these up would leak exactly the data the exclusion exists
      to protect. The crash journal carries stack traces from this device.
    -->
    <exclude domain="file" path="db-snapshots" />
    <exclude domain="file" path="crash" />
    <!-- Progress photos stay on this phone and in the lifter's own backup folder; Google's backup and device transfer never carry them. -->
    <exclude domain="file" path="photos" />
    <!--
      App state that only makes sense beside the database above. Restored
      without it, "onboarding" (dismissed) and "program_answers" skip first run
      into an empty app, and "reminders" shows a toggle that is on while no
      work is scheduled and notification permission is gone.
    -->
    <exclude domain="sharedpref" path="onboarding.xml" />
    <exclude domain="sharedpref" path="program_answers.xml" />
    <exclude domain="sharedpref" path="reminders.xml" />
    <!-- The folder permission belongs to this install; a restored folder name would show a backup that is no longer on. -->
    <exclude domain="sharedpref" path="auto_backup.xml" />
    <!-- The warm-up answer names a trial id, which means nothing in a fresh database. -->
    <exclude domain="sharedpref" path="warmup.xml" />
    <!-- The notify mark and first-ask flag belong to this install's account and permission state. -->
    <exclude domain="sharedpref" path="inbox_notifier.xml" />
    <!-- Paid-circle-week flags are meaningless, and double-paying-adjacent, without the database. -->
    <exclude domain="sharedpref" path="warband_payout.xml" />
    <exclude domain="sharedpref" path="circle_payout.xml" />
    <exclude domain="sharedpref" path="rank_state.xml" />
    <exclude domain="sharedpref" path="health_write.xml" />
    <exclude domain="sharedpref" path="health_resume.xml" />
    <exclude domain="sharedpref" path="weekly_recap.xml" />
    <exclude domain="sharedpref" path="suggestion_dismissals.xml" />
    <!-- The cloud sign-in: supabase-kt keeps its access and refresh token here (its default
         SettingsSessionManager). Restored elsewhere, two installs would share one rotating token. -->
    <exclude domain="sharedpref" path="com.ironvellum.app_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
