<?xml version="1.0" encoding="utf-8"?>
<!-- The primary button: the app's 8dp chamfer as two cap vectors and a solid between,
     tinted with the lifter's accent at render time (the tint here is only the picker's). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/btn_fill"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_fill_l"
            android:layout_width="9dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cap_left"
            android:tint="#34D399" />

        <ImageView
            android:id="@+id/btn_fill_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="-1dp"
            android:layout_marginEnd="-1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_solid"
            android:tint="#34D399" />

        <ImageView
            android:id="@+id/btn_fill_r"
            android:layout_width="9dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cap_right"
            android:tint="#34D399" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_fill_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_play" />

        <TextView
            android:id="@+id/btn_fill_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/chakra_petch_semibold"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="Begin Push"
            android:textColor="#0C0C0B"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
