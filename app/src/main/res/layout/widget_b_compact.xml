<?xml version="1.0" encoding="utf-8"?>
<!-- Widget B on a 2x1 cell: the streak, seven small marks for the week, and one square button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
            android:id="@+id/b_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="4"
            android:textColor="#F2C14E"
            android:textSize="24sp" />

                <TextView
            android:id="@+id/b_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="day streak"
            android:textColor="#A3A099"
            android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/b_dots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/b_dot1"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_diamond"
                    android:tint="#34D399" />

                <ImageView
                    android:id="@+id/b_dot2"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_diamond"
                    android:tint="#34D399" />

                <ImageView
                    android:id="@+id/b_dot3"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_diamond_outline"
                    android:tint="#A3A099" />

                <ImageView
                    android:id="@+id/b_dot4"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_diamond"
                    android:tint="#34D399" />

                <ImageView
                    android:id="@+id/b_dot5"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_diamond_outline"
                    android:tint="#A3A099" />

                <ImageView
                    android:id="@+id/b_dot6"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_diamond_outline"
                    android:tint="#A3A099" />

                <ImageView
                    android:id="@+id/b_dot7"
                    android:layout_width="0dp"
                    android:layout_height="9dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_diamond_outline"
                    android:tint="#A3A099" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/w_square"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp">

            <ImageView
                android:id="@+id/w_square_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_chamfer_square"
                android:tint="#34D399" />

            <ImageView
                android:id="@+id/w_square_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_play" />

            <ImageView
                android:id="@+id/w_square_tick"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_check"
                android:tint="#34D399"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
