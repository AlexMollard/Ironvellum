<?xml version="1.0" encoding="utf-8"?>
<!-- Streak & week on a 4x1 cell: the streak, a rule and the seven date columns. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,ContentDescription"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/k_block"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:minWidth="44dp">
            <TextView
                android:id="@+id/k_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="28sp"
                android:textColor="#F2C14E"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="4"
                android:fontFeatureSettings="tnum"
                android:layout_marginTop="-3dp"
                android:layout_marginBottom="-5dp" />
            <TextView
                android:id="@+id/k_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="#A3A099"
                android:text="@string/widget_preview_streak_caption"
                android:layout_marginTop="2dp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/k_rule"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_solid"
            android:scaleType="fitXY"
            android:tint="#32302B"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:id="@+id/cols"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_weight="1"
            android:layout_marginStart="-1dp"
            android:layout_marginEnd="-1dp" />
    </LinearLayout>
</FrameLayout>
