<?xml version="1.0" encoding="utf-8"?>
<!-- The quiet button: the same chamfer as an outline (a Rune ring over a Vault face), its label in the accent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/btn_out"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_out_ring_l"
            android:layout_width="9dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cap_left"
            android:tint="#32302B" />

        <ImageView
            android:id="@+id/btn_out_ring_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="-1dp"
            android:layout_marginEnd="-1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_solid"
            android:tint="#32302B" />

        <ImageView
            android:id="@+id/btn_out_ring_r"
            android:layout_width="9dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cap_right"
            android:tint="#32302B" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_out_face_l"
            android:layout_width="9dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cap_left"
            android:tint="#171715" />

        <ImageView
            android:id="@+id/btn_out_face_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="-1dp"
            android:layout_marginEnd="-1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_solid"
            android:tint="#171715" />

        <ImageView
            android:id="@+id/btn_out_face_r"
            android:layout_width="9dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cap_right"
            android:tint="#171715" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_out_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_preview_begin_empty"
        android:textColor="#34D399"
        android:textSize="15sp" />
</FrameLayout>
