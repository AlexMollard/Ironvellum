<?xml version="1.0" encoding="utf-8"?>
<!-- Widget B, streak and week, 4x2 and up. The text is the picker's preview; TodayWidget.render replaces it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
            android:id="@+id/b_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/chakra_petch_bold"
            android:maxLines="1"
            android:text="4"
            android:textColor="#F2C14E"
            android:textSize="34sp" />

                <TextView
            android:id="@+id/b_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/chakra_petch_medium"
            android:maxLines="1"
            android:text="day streak"
            android:textColor="#A3A099"
            android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
            android:id="@+id/b_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/chakra_petch_semibold"
            android:maxLines="1"
                android:gravity="end"
                android:letterSpacing="0.1"
                android:textAllCaps="true"
            android:text="PUSH"
            android:textColor="#E8E8E4"
            android:textSize="15sp" />

                <TextView
            android:id="@+id/b_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/chakra_petch_medium"
            android:maxLines="1"
                android:gravity="end"
            android:text="Today · 18 sets"
            android:textColor="#A3A099"
            android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/b_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/b_cell_bg1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cell_today"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/b_day1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_medium"
                    android:text="M"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/b_dayb1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_bold"
                    android:text="M"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/b_mark1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond"
                    android:tint="#34D399"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/b_cell_bg2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cell_today"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/b_day2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_medium"
                    android:text="T"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/b_dayb2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_bold"
                    android:text="T"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/b_mark2"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond"
                    android:tint="#34D399"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/b_cell_bg3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cell_today"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/b_day3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_medium"
                    android:text="W"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/b_dayb3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_bold"
                    android:text="W"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/b_mark3"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond_outline"
                    android:tint="#E8E8E4"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/b_cell_bg4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cell_today"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/b_day4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_medium"
                    android:text="T"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/b_dayb4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_bold"
                    android:text="T"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/b_mark4"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond"
                    android:tint="#34D399"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/b_cell_bg5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cell_today"
                android:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/b_day5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_medium"
                    android:text="F"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/b_dayb5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_bold"
                    android:text="F"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/b_mark5"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond_outline"
                    android:tint="#E8E8E4"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/b_cell_bg6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cell_today"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/b_day6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_medium"
                    android:text="S"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/b_dayb6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_bold"
                    android:text="S"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/b_mark6"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond_outline"
                    android:tint="#E8E8E4"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp">

            <ImageView
                android:id="@+id/b_cell_bg7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cell_today"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/b_day7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_medium"
                    android:text="S"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/b_dayb7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/chakra_petch_bold"
                    android:text="S"
                    android:textColor="#E8E8E4"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/b_mark7"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond_outline"
                    android:tint="#E8E8E4"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            layout="@layout/widget_btn_fill"
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <TextView
            android:id="@+id/b_line"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:ellipsize="end"
            android:fontFamily="@font/chakra_petch_medium"
            android:maxLines="1"
        android:gravity="center"
            android:text="Next: Legs · Sun"
            android:textColor="#A3A099"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
