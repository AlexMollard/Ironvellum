<?xml version="1.0" encoding="utf-8"?>
<!-- Widget A on a 2x1 cell: the name, the streak and the set count, and one square button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
            android:id="@+id/a_title"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:letterSpacing="0.09"
            android:textAllCaps="true"
            android:text="@string/widget_preview_title"
            android:textColor="#E8E8E4"
            android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/a_streak_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond"
                    android:tint="#F2C14E" />

                <TextView
            android:id="@+id/a_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_compact_meta"
            android:textColor="#A3A099"
            android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/w_square"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp">

            <ImageView
                android:id="@+id/w_square_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_chamfer_square"
                android:tint="#34D399" />

            <ImageView
                android:id="@+id/w_square_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_play" />

            <ImageView
                android:id="@+id/w_square_tick"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_check"
                android:tint="#34D399"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
