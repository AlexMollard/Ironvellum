<?xml version="1.0" encoding="utf-8"?>
<!-- One set pip of a 4x2 row. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,ContentDescription,UseCompoundDrawables,UselessParent,UselessLeaf,SmallSp,NestedWeights,TooManyViews"
    android:layout_width="7dp"
    android:layout_height="7dp"
    android:clipChildren="false"
    android:layout_marginStart="3dp">
    <ImageView
        android:id="@+id/pip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_pip_fill"
        android:scaleType="fitXY"
        android:tint="#32302B" />
    <ImageView
        android:id="@+id/pip_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_fill05"
        android:scaleType="fitXY"
        android:tint="#32302B"
        android:layout_margin="1.5dp"
        android:visibility="gone" />
</FrameLayout>
