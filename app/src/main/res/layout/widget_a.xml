<?xml version="1.0" encoding="utf-8"?>
<!-- Widget A, the day card, 4x2 and up. The text is the picker's preview; TodayWidget.render replaces it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    tools:ignore="ContentDescription,HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
            android:id="@+id/a_kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:text="@string/widget_preview_kicker"
            android:textColor="#A3A099"
            android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/a_streak_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/a_streak_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_diamond"
                    android:tint="#F2C14E" />

                <TextView
            android:id="@+id/a_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_streak"
            android:textColor="#E8E8E4"
            android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/a_tick"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_check"
                android:tint="#34D399"
                android:visibility="gone" />

            <TextView
            android:id="@+id/a_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:letterSpacing="0.09"
            android:textAllCaps="true"
            android:text="@string/widget_preview_title"
            android:textColor="#E8E8E4"
            android:textSize="22sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/a_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <TextView
            android:id="@+id/a_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_meta"
            android:textColor="#A3A099"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            layout="@layout/widget_btn_fill"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <include
            layout="@layout/widget_btn_outline"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/a_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/a_rule"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_solid"
                android:tint="#32302B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
            android:id="@+id/a_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
                android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_next_tue"
            android:textColor="#A3A099"
            android:textSize="13sp" />

                <TextView
            android:id="@+id/a_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_open"
            android:textColor="#A3A099"
            android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
