<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's live sample: the card with sample content in the places the face fills. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" tools:ignore="HardcodedText,ContentDescription,UseCompoundDrawables,UselessParent,UselessLeaf,SmallSp,NestedWeights,TooManyViews"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:baselineAligned="false"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:layout_weight="1">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:baselineAligned="false"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/h_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="17sp"
                        android:textColor="#E8E8E4"
                        android:fontFamily="sans-serif"
                        android:textStyle="bold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.035"
                        android:text="@string/widget_preview_title" />
                    <LinearLayout
                        android:id="@+id/h_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:layout_marginStart="8dp">
                        <ImageView
                            android:id="@+id/h_streak_icon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_diamond"
                            android:tint="#F2C14E" />
                        <TextView
                            android:id="@+id/h_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textSize="12sp"
                            android:textColor="#E8E8E4"
                            android:fontFamily="sans-serif-medium"
                            android:text="4"
                            android:layout_marginStart="4dp"
                            android:fontFeatureSettings="tnum" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/h_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="#A3A099"
                    android:text="@string/widget_preview_meta"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/act"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp">
                <FrameLayout
                    android:id="@+id/act_play"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clipChildren="false">
                    <ImageView
                        android:id="@+id/act_play_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_chamfer40"
                        android:scaleType="fitXY"
                        android:tint="#34D399" />
                    <ImageView
                        android:id="@+id/act_play_icon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_play"
                        android:tint="#0C0C0B"
                        android:layout_gravity="center" />
                </FrameLayout>
                <ImageView
                    android:id="@+id/act_tick"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_tick"
                    android:tint="#34D399"
                    android:visibility="gone" />
                <FrameLayout
                    android:id="@+id/act_ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:clipChildren="false"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/act_ghost_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_fill6"
                        android:scaleType="fitXY"
                        android:tint="#32302B" />
                    <ImageView
                        android:id="@+id/act_ghost_face"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_fill5"
                        android:scaleType="fitXY"
                        android:tint="#32302B"
                        android:layout_margin="1dp" />
                    <TextView
                        android:id="@+id/act_ghost_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="14sp"
                        android:textColor="#34D399"
                        android:fontFamily="sans-serif"
                        android:textFontWeight="600"
                        android:text="Workout"
                        android:layout_gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/act_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:clipChildren="false"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:baselineAligned="false">
                        <ImageView
                            android:id="@+id/act_pill_l"
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_cap_left"
                            android:scaleType="fitXY"
                            android:tint="#34D399" />
                        <ImageView
                            android:id="@+id/act_pill_c"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_solid"
                            android:scaleType="fitXY"
                            android:tint="#34D399"
                            android:layout_weight="1"
                            android:layout_marginStart="-1dp"
                            android:layout_marginEnd="-1dp" />
                        <ImageView
                            android:id="@+id/act_pill_r"
                            android:layout_width="6dp"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_cap_right"
                            android:scaleType="fitXY"
                            android:tint="#34D399" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">
                        <ImageView
                            android:id="@+id/act_pill_icon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_play"
                            android:tint="#0C0C0B"
                            android:layout_marginEnd="6dp" />
                        <TextView
                            android:id="@+id/act_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textSize="14sp"
                            android:textColor="#0C0C0B"
                            android:fontFamily="sans-serif"
                            android:textFontWeight="600"
                            android:text="Begin" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:layout_marginTop="6dp"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipChildren="false"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:layout_weight="1"
                android:minHeight="26dp">
                <ImageView
