                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="#E8E8E4"
                        android:text="Bench Press"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp" />
                    <LinearLayout
                        android:id="@+id/row_pips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:baselineAligned="false"
                        android:layout_marginStart="-3dp"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone"
                        android:gravity="center_vertical" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:baselineAligned="false"
                        android:minWidth="70dp"
                        android:gravity="end|center_vertical">
                        <ImageView
                            android:id="@+id/row_star"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_star"
                            android:tint="#F2C14E"
                            android:layout_marginEnd="4dp"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/row_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textSize="12sp"
                            android:textColor="#A3A099"
                            android:text="4 × 6 · 72.5 kg"
                            android:fontFeatureSettings="tnum" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipChildren="false"
                android:layout_marginStart="-6dp"
                android:layout_marginEnd="-6dp"
                android:layout_weight="1"
                android:minHeight="26dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_fill4"
                    android:scaleType="fitXY"
                    android:tint="#10241C"
                    android:visibility="gone" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">
                    <FrameLayout
                        android:layout_width="12dp"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:layout_marginEnd="8dp">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_check"
                            android:tint="#34D399"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_play"
                            android:tint="#34D399"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_dot"
                            android:tint="#32302B"
                            android:layout_gravity="center" />
                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_diamond"
                            android:tint="#34D399"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="#E8E8E4"
                        android:text="Overhead Press"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:baselineAligned="false"
                        android:layout_marginStart="-3dp"
