<!--
  Empty quests: sealed gate with dormant rune core. Original artwork.

  The viewport is cropped to the ink instead of the original 96x96 square: the
  mark only occupied the middle ~60% of that box, so at any size the drawable
  letterboxed itself and rendered postage-stamp small inside a panel with room
  to spare. Path data is unchanged — the group translate moves the origin to the
  ink's top-left (x 18.5, y 16.5, half a 3px stroke outside the path extents),
  and width/height keep the 59:69 ink aspect.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="82dp" android:height="96dp"
    android:viewportWidth="59" android:viewportHeight="69">
    <group android:translateX="-18.5" android:translateY="-16.5">
        <path android:pathData="M26,84 V42 L44,22 H52 L70,42 V84"
            android:strokeWidth="3" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeColor="#2A2D35"/>
        <path android:pathData="M38,84 V50 L48,38 H52 L62,50 V84"
            android:strokeWidth="3" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeColor="#2A2D35"/>
        <path android:pathData="M48,56 a6,6 0 1,0 0.01,0 Z"
            android:strokeWidth="3" android:strokeColor="#34D399"/>
        <path android:pathData="M20,84 H76"
            android:strokeWidth="3" android:strokeLineCap="round" android:strokeColor="#2A2D35"/>
        <path android:pathData="M48,26 V18 M30,34 L24,28 M66,34 L72,28"
            android:strokeWidth="3" android:strokeLineCap="round" android:strokeColor="#2A2D35"/>
    </group>
</vector>
