<?xml version="1.0" encoding="utf-8"?>
<!--
  Empty stats: dark system window with a dormant chart trace. Original artwork.

  Viewport cropped to the ink for the same reason as art_empty_quests, and
  crucially with the SAME treatment: stroke width is measured in viewport units,
  so cropping one asset and not the other would render the two empty states at
  visibly different line weights. Ink spans x 12.5-83.5, y 16.5-79.5 including
  half of the 3px stroke; width/height keep the 71:63 aspect.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp" android:height="85dp"
    android:viewportWidth="71" android:viewportHeight="63">
    <group android:translateX="-12.5" android:translateY="-16.5">
        <path android:pathData="M14,18 H82 V78 H14 Z"
            android:strokeWidth="3" android:strokeLineJoin="round" android:strokeColor="#2A2D35"/>
        <path android:pathData="M14,30 H82"
            android:strokeWidth="3" android:strokeColor="#2A2D35"/>
        <path android:pathData="M20,24 H26 M32,24 H38"
            android:strokeWidth="3" android:strokeLineCap="round" android:strokeColor="#2A2D35"/>
        <path android:pathData="M24,66 L38,52 L50,60 L70,42"
            android:strokeWidth="3" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeColor="#34D399"/>
        <path android:pathData="M24,70 H72"
            android:strokeWidth="3" android:strokeLineCap="round" android:strokeColor="#2A2D35"/>
    </group>
</vector>
