<?xml version="1.0" encoding="utf-8"?>
<!-- The Train tab's glyph: one slim blade, point up and to the right. Original
     artwork, drawn upright and turned onto the diagonal so it spans the box
     corner to corner; the fuller is cut through, so the plate shows in it. The
     tint comes from the nav slot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <group android:pivotX="12" android:pivotY="12" android:rotation="45"
        android:scaleX="1.15" android:scaleY="1.15">
        <!-- Blade, tapering to the point, with the fuller cut out. -->
        <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd"
            android:pathData="M12,-1.5 L13.25,3 L13.25,16.9 L10.75,16.9 L10.75,3 Z M11.7,4.5 L12.3,4.5 L12.3,16 L11.7,16 Z" />
        <!-- Crossguard. -->
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M7.2,16.9 L16.8,16.9 L16.8,18.6 L7.2,18.6 Z" />
        <!-- Grip. -->
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M11.15,18.6 L12.85,18.6 L12.85,22.9 L11.15,22.9 Z" />
        <!-- Pommel. -->
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M10.65,24.2 A1.35,1.35 0 1,0 13.35,24.2 A1.35,1.35 0 1,0 10.65,24.2 Z" />
    </group>
</vector>
